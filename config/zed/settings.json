{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "opencode": {
      "type": "registry"
    },
  },
  "context_servers": {
    "context7-mcp": {
      "enabled": false,
      "command": "context7-mcp",
      "args": [],
    },
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "enable_thinking": false
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "auto_install_extensions": {
    "basher": true,
    "biome": true,
    "catppuccin": true,
    "docker-compose": true,
    "dockerfile": true,
    "emmet": true,
    "fish": true,
    "git-firefly": true,
    "haskell": true,
    "html": true,
    "just": true,
    "log": true,
    "lua": true,
    "make": true,
    "nix": true,
    "svelte": true,
    "toml": true,
  },
  "autosave": { "after_delay": { "milliseconds": 1500 } },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "tab_size": 2,
  "format_on_save": "on",
  "theme": {
    "mode": "system",
    "light": "Catppuccin Macchiato",
    "dark": "Catppuccin Macchiato",
  },
  "terminal": {
    "line_height": "standard",
  },
  "lsp": {
    "nil": {
      "settings": {
        "formatting": {
          "command": ["nixfmt"],
        },
        "nix": {
          "flake": {
            "autoArchive": true,
          },
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "command": "clippy",
          "workspace": false,
          "extraArgs": ["--no-deps"],
        },
      },
    },
  },
}
